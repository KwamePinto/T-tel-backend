# ---------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored — never commit it.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=

# Database name (the URI often omits it; without this Mongo uses "test")
DB_NAME=ttel

# Secret used to sign auth tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Where the browser reaches this API, and where the site is served from.
# Used for CORS and for building absolute media URLs.
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5000

# ---- File storage -------------------------------------------------
# local | s3
#
# "local" keeps uploads on this machine's disk. That is fine in development,
# but on Render the filesystem is wiped on every deploy and every wake from
# sleep, so uploads do not survive. Use s3 in production.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# ---- Cloudflare R2 (or any S3-compatible bucket) -------------------
# Only read when STORAGE_DRIVER=s3.
#
# Where to find each value in the Cloudflare dashboard:
#
#   R2 > Overview                      your Account ID appears top right
#   R2 > <bucket> > Settings           the bucket name, and Public URL if enabled
#   R2 > Manage API tokens > Create    gives the Access Key ID and Secret
#
# The token needs "Object Read & Write" on this bucket. The secret is shown
# once — copy it then.

# https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (no bucket name in this URL)
S3_ENDPOINT=

# R2 ignores the region but the AWS SDK requires one. Leave this as auto.
S3_REGION=auto

S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The bucket's public address, used to serve images directly to the browser.
# Enable it under R2 > <bucket> > Settings > Public Development URL, which
# gives an https://pub-....r2.dev address, or attach your own domain.
#
# Leave this blank and images still work, but every request is redirected
# through a signed URL, which is slower and uses more of the API's time.
S3_PUBLIC_BASE_URL=

# ---- First admin account -----------------------------------------
# Used once by `npm run seed` to create the initial login.
SEED_ADMIN_NAME=T-TEL Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Outbound email (form notifications) -------------------------
# Optional. Leave blank to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="T-TEL <no-reply@t-tel.org>"

# Days a trashed item is kept before permanent deletion
TRASH_RETENTION_DAYS=30
