# ---------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored — never commit it.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=

# Database name (the URI often omits it; without this Mongo uses "test")
DB_NAME=ttel

# Secret used to sign auth tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Where the browser reaches this API, and where the site is served from.
# Used for CORS and for building absolute media URLs.
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5000

# ---- File storage -------------------------------------------------
# local | s3   (s3 also covers Cloudflare R2 and other S3-compatible hosts)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Only needed when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- First admin account -----------------------------------------
# Used once by `npm run seed` to create the initial login.
SEED_ADMIN_NAME=T-TEL Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Outbound email (form notifications) -------------------------
# Optional. Leave blank to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="T-TEL <no-reply@t-tel.org>"

# Days a trashed item is kept before permanent deletion
TRASH_RETENTION_DAYS=30
