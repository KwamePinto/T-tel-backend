# ---------------------------------------------------------------------------
# Copy to handover/.env and fill in. This file is git-ignored — never commit
# it, since it holds two full sets of live credentials at once.
#
# This is separate from the application's own .env on purpose: these two
# scripts need to see BOTH the developer's and the client's infrastructure
# in the same run, which the app itself never does.
#
# See handover/README.md for the full walkthrough of when and how to run
# these — this file only lists what the values mean.
# ---------------------------------------------------------------------------

# ==== Database (clone-database.mjs) ========================================

# The developer's MongoDB Atlas cluster — where the live content is today.
# Atlas > Database > Connect > Drivers, the same shape of string already in
# the application's own .env as MONGO_URI.
SOURCE_MONGO_URI=
SOURCE_DB_NAME=ttel

# The client's MongoDB database — where this instance's future content will
# live in production. Get this connection string from the client (their own
# Atlas project, or one you create for them under their billing).
DEST_MONGO_URI=
DEST_DB_NAME=ttel

# ==== File storage (migrate-r2-bucket.mjs) ==================================
#
# Where to find each value in the Cloudflare dashboard, for EITHER account:
#
#   R2 > Overview                      the Account ID appears top right
#   R2 > <bucket> > Settings           the bucket name
#   R2 > Manage API tokens > Create    Access Key ID and Secret Access Key
#
# The token needs "Object Read" on the source bucket and "Object Read &
# Write" on the destination bucket. The secret is shown once — copy it then.

# The developer's bucket — where the Knowledge Hub PDFs and site images live
# today.
SOURCE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
SOURCE_S3_REGION=auto
SOURCE_S3_BUCKET=
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=

# The client's bucket — where the files should end up. Create this bucket in
# the client's own Cloudflare account before running the script.
DEST_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
DEST_S3_REGION=auto
DEST_S3_BUCKET=
DEST_S3_ACCESS_KEY_ID=
DEST_S3_SECRET_ACCESS_KEY=
