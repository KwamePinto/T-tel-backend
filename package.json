{
  "name": "t-tel-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "T-TEL CMS API — Express + MongoDB, with Cloudflare R2 file storage",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/run.js",
    "seed:reset": "node src/seed/run.js --reset",
    "ingest:docs": "node src/seed/ingestDocs.js",
    "handover:clone-db": "node handover/clone-database.mjs",
    "handover:migrate-storage": "node handover/migrate-r2-bucket.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/lib-storage": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-to-img": "^7.0.0",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6"
  },
  "engines": {
    "node": ">=20"
  }
}
